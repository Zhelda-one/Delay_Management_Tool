FROM fivegmax-docker-local.artifactory-espoo1.int.net.nokia.com/5gmax_container:latest

ENV https_proxy=http://10.158.100.2:8080

RUN apt-get update && apt-get install -y \
    iputils-ping \
    sudo \
    zip \
    curl \
    nodejs \
    npm

RUN apt-get clean


RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y



# Default g++ version is g++-10, but npm installs g++-11, which doesn't compile
RUN rm /usr/bin/gcc
RUN rm /usr/bin/g++
RUN ln -s /usr/bin/gcc-10 /usr/bin/gcc
RUN ln -s /usr/bin/g++-10 /usr/bin/g++

RUN groupadd ServerGroup
RUN useradd -rm -d /home/banski -s /bin/bash -g ServerGroup -G root -u 1001 banski | chpasswd && adduser banski sudo
RUN useradd -rm -d /home/ServerUser -s /bin/bash -g ServerGroup -G root -u 10001 ServerUser | chpasswd && adduser ServerUser sudo

